# Optional overrides — copy to `.env` (which is gitignored).
# WARNING: every VITE_* variable is bundled into the public JS, so never put
# a secret key here. The Hugging Face token is entered in the app at runtime.

# Self-host the MediaPipe files for fully offline use:
# VITE_POSE_WASM=/mediapipe/wasm
# VITE_POSE_MODEL=/mediapipe/pose_landmarker_lite.task
# VITE_SEG_MODEL=/mediapipe/selfie_segmenter.tflite
